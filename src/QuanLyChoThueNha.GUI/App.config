<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <!--
    ⚠️ QUAN TRỌNG: Chuỗi kết nối PHẢI đặt ở file App.config của project Startup (GUI).
    Đổi Server=.\SQLEXPRESS thành tên SQL Server thực tế trên máy bạn.
    Ví dụ: Server=(localdb)\MSSQLLocalDB  nếu dùng LocalDB
  -->
  <connectionStrings>
    <add name="QuanLyChoThueNhaContext" connectionString="Server=localhost\MSSQLSERVER01        ;Database=QuanLyChoThueNha;Integrated Security=True;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="PaymentBankCode" value="MB" />
    <add key="PaymentAccountNo" value="0352236785" />
    <add key="PaymentAccountName" value="QUAN LY CHO THUE NHA" />
    <add key="PaymentQrImagePath" value="" />
    <add key="EmailEnabled" value="true" />
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpUser" value="ph10650@gmail.com" />
    <add key="SmtpPassword" value="fftilwifzwplezrb" />
    <add key="SmtpFrom" value="ph10650@gmail.com" />
    <add key="SmtpFromName" value="A+DotNet" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    </providers>
  </entityFramework>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
